PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Storage configuration
STORAGE_TYPE=filesystem
STORAGE_PATH=./uploads

# Database
DATA_DIR=./data
DB_FILENAME=graphite.db

# Security
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=application/pdf

# Authentication
# Optional: if omitted, Graphite will generate a persistent secret in DATA_DIR/session-secret
# SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long
# Optional override for where the generated secret is stored
# SESSION_SECRET_FILE=./data/session-secret
# Optional override for first-run admin password (otherwise Graphite generates a random one and logs it once)
# BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-boot

# Trust proxy (set when behind nginx/traefik/etc.)
# TRUST_PROXY=1
# When the session cookie gets the Secure flag:
#   auto  (default) Secure on HTTPS requests only; behind a TLS-terminating proxy this needs TRUST_PROXY
#   true  always Secure; sign-in will not work over plain HTTP
#   false never Secure
# COOKIE_SECURE=auto
# Public app origin(s) used for CSRF checks when behind a proxy or tunnel
# ALLOWED_ORIGINS=https://graphite.example.com,https://draw.example.com
# Backward-compatible single-origin setting
# ALLOWED_ORIGIN=https://graphite.example.com
